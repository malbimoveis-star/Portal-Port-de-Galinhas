# Porta do servidor backend
PORT=3000

# Ambiente
NODE_ENV=development

# Segredo usado para assinar tokens JWT do painel do comerciante
JWT_SECRET=troque_este_valor_por_um_segredo_forte

# PostgreSQL - o Render fornece essa URL automaticamente quando voce
# conecta um banco Postgres ao servico (Settings > Environment > Add Database).
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Mercado Pago - Access Token de TESTE (sandbox). Obtenha em:
# https://www.mercadopago.com.br/developers/panel/app
# NUNCA commitar o token real. Use apenas em .env local / variaveis de ambiente do provedor de deploy.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL publica do frontend (usada para montar back_urls do Mercado Pago)
# Backend e frontend agora rodam juntos na mesma porta/URL.
FRONTEND_URL=http://localhost:3000

# URL publica do backend (usada para montar notification_url do webhook)
BACKEND_URL=http://localhost:3000

# Dias de degustacao gratuita para novos comerciantes
DIAS_DEGUSTACAO=5

# Credenciais do painel administrativo (/admin) - troque antes de ir para producao
ADMIN_USER=admin
ADMIN_PASS=admin123


# E-mail transacional (confirmacao de cadastro e recuperacao de senha) via Gmail SMTP.
# EMAIL_USER: o endereco do Gmail que envia os e-mails (ex: portalportodegalinhaspe@gmail.com)
# EMAIL_APP_PASSWORD: uma Senha de App gerada em myaccount.google.com/apppasswords
# (NUNCA a senha normal da conta Google, e NUNCA commitar o valor real aqui).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Fase 2 do dashboard: para onde enviar avisos automaticos ao admin (novo
# comerciante cadastrado, anuncio pendente de aprovacao, pagamento aprovado).
# Se deixar em branco, cai no EMAIL_USER acima como destinatario.
ADMIN_EMAIL=
